[system]
language = "en"
api_keys = []
encrypt_key = "${env:DBGPT_ENCRYPT_KEY}"
[service.web]
host = "0.0.0.0"
port = 5670
[service.web.database]
type = "sqlite"
path = "/app/pilot/meta_data/dbgpt.db"
[rag.storage.vector]
type = "chroma"
persist_path = "/app/pilot/data"
[models]
[[models.llms]]
name = "quality"
provider = "proxy/openai"
api_base = "http://litellm:4000/v1"
api_key = "${env:LITELLM_MASTER_KEY}"
[[models.llms]]
name = "fast"
provider = "proxy/openai"
api_base = "http://litellm:4000/v1"
api_key = "${env:LITELLM_MASTER_KEY}"
[[models.embeddings]]
name = "embeddings"
provider = "proxy/openai"
api_url = "http://litellm:4000/v1/embeddings"
api_key = "${env:LITELLM_MASTER_KEY}"
